+/**
+ * Extract the outermost balanced JSON value (array or object) from a reply.
+ *
+ * Replaces the greedy `/\[[\s\S]*\]/` extraction, which anchors on the FIRST
+ * `[` in the text — inside a reply whose top level is an object it lands on an
+ * inner array (e.g. a scene's `memories`), so the caller then parses memory
+ * objects as if they were scenes and drops the whole extraction as
+ * `empty_scenes`. Verified against the local gateway (2026-10-11): a reply
+ * shaped `{"scene_name":…,"memories":[…]} ` yielded 3 empty scenes.
+ *
+ * The scan is quote-aware, so brackets inside string literals do not unbalance
+ * it, and it returns the first `[`/`{` span that closes at depth zero —
+ * whichever delimiter comes first wins, matching how a top-level array or a
+ * top-level object both round-trip. Returns null when no balanced value exists.
+ */
+export function extractOutermostJson(text: string): string | null {
+  let start = -1;
+  let open = "";
+  let close = "";
+
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i]!;
+    if (ch !== "[" && ch !== "{") continue;
+    start = i;
+    open = ch;
+    close = ch === "[" ? "]" : "}";
+    break;
+  }
+  if (start < 0) return null;
+
+  let depth = 0;
+  let inString = false;
+  for (let i = start; i < text.length; i++) {
+    const ch = text[i]!;
+    if (inString) {
+      if (ch === "\\") {
+        i++; // skip the escaped character entirely
+        continue;
+      }
+      if (ch === '"') inString = false;
+      continue;
+    }
+    if (ch === '"') {
+      inString = true;
+      continue;
+    }
+    if (ch === open) {
+      depth++;
+    } else if (ch === close) {
+      depth--;
+      if (depth === 0) return text.slice(start, i + 1);
+    }
+  }
+  return null;
+}
