+/**
+ * Repro harness: run the real L1 extraction prompt through the real upstream and
+ * print the raw reply, so the failure mode can be read directly instead of
+ * inferred from aggregate counters.
+ *
+ * The user turn is assembled the same way StandaloneLLMRunner assembles it for
+ * pure-text calls: `prompt + outputContract`. Without the contract an agentic
+ * chat gateway downgrades the system-turn JSON spec to advisory context and
+ * answers in prose / fenced YAML — this harness lets you see that directly.
+ *
+ * Usage:
+ *   TDAI_LLM_BASE_URL=... TDAI_LLM_API_KEY=... TDAI_LLM_MODEL=... \
+ *     node --import tsx scripts/dbg-l1-raw.ts [--no-contract]
+ */
+import { createOpenAI } from "@ai-sdk/openai";
+import { generateText } from "ai";
+import {
+  getExtractMemoriesSystemPrompt,
+  formatExtractionPrompt,
+  L1_JSON_OUTPUT_CONTRACT,
+} from "../src/core/prompts/l1-extraction.js";
+
+const baseUrl = process.env.TDAI_LLM_BASE_URL;
+const apiKey = process.env.TDAI_LLM_API_KEY;
+const model = process.env.TDAI_LLM_MODEL;
+if (!baseUrl || !apiKey || !model) {
+  console.error("Required: TDAI_LLM_BASE_URL, TDAI_LLM_API_KEY, TDAI_LLM_MODEL");
+  process.exit(1);
+}
+
+const withContract = !process.argv.includes("--no-contract");
+
+const now = Date.now();
+const sys = getExtractMemoriesSystemPrompt("chat");
+const usr = formatExtractionPrompt({
+  newMessages: [
+    { id: "m1", role: "user", content: "我的个人偏好清单：1) 部署脚本必须先做健康检查再启动；2) 所有交付产物放 shared 目录不放 workspace；3) 远程服务器是 119.13.109.93，别名 vps，已配好密钥登录。", timestamp: now },
+    { id: "m2", role: "assistant", content: "收到，我把三条都记进长期记忆。", timestamp: now + 1000 },
+  ] as never,
+  backgroundMessages: [],
+  previousSceneName: "无",
+});
+
+const provider = createOpenAI({ baseURL: baseUrl, apiKey, compatibility: "compatible" });
+const res = await generateText({
+  model: provider.chat(model),
+  system: sys,
+  prompt: withContract ? `${usr}${L1_JSON_OUTPUT_CONTRACT}` : usr,
+  maxOutputTokens: 4096,
+});
+
+console.log(`=== RAW REPLY (contract=${withContract ? "on" : "off"}) ===`);
+console.log(res.text);
+console.log("=== END ===");
