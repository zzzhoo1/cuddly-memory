+import { describe, it, expect } from "vitest";
+import { extractOutermostJson } from "./sanitize.js";
+
+describe("extractOutermostJson", () => {
+  it("returns the whole array for an array-first reply", () => {
+    const text = '[{"scene_name":"a","memories":[{"content":"m"}]}]';
+    expect(extractOutermostJson(text)).toBe(text);
+  });
+
+  it("returns the whole object for an object-first reply (inner arrays must not anchor)", () => {
+    // Regression: a greedy /\[[\s\S]*\]/ anchors on the inner `memories` array
+    // here, so the caller parsed three memory objects as if they were scenes and
+    // dropped the extraction as empty_scenes.
+    const text = '{"scene_name":"a","message_ids":["m1"],"memories":[{"content":"x"},{"content":"y"}]}';
+    const span = extractOutermostJson(text);
+    expect(span).toBe(text);
+    expect(JSON.parse(span!).scene_name).toBe("a");
+  });
+
+  it("ignores leading prose and trailing fences", () => {
+    const text = 'Sure! Here is the JSON:\n[{"a":1}]\n```';
+    expect(extractOutermostJson(text)).toBe('[{"a":1}]');
+  });
+
+  it("does not let brackets inside string literals unbalance the scan", () => {
+    const text = '{"note":"use [ ] braces } here","memories":[{"content":"a[b]c"}]}';
+    expect(extractOutermostJson(text)).toBe(text);
+  });
+
+  it("handles escaped quotes inside strings", () => {
+    const text = '{"note":"say \\"hi\\" [x]","memories":[]}';
+    expect(extractOutermostJson(text)).toBe(text);
+  });
+
+  it("returns null when no balanced JSON value exists", () => {
+    expect(extractOutermostJson("no json at all")).toBeNull();
+    expect(extractOutermostJson('{"broken": [1, 2')).toBeNull();
+  });
+});
