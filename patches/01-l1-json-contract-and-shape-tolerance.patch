diff --git a/MemoryCore/src/core/record/l1-extractor.test.ts b/MemoryCore/src/core/record/l1-extractor.test.ts
new file mode 100644
index 0000000..2c01b8c
--- /dev/null
+++ b/MemoryCore/src/core/record/l1-extractor.test.ts
@@ -0,0 +1,213 @@
+import { describe, it, expect, beforeEach, afterEach } from "vitest";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { extractL1Memories } from "./l1-extractor.js";
+import { L1_JSON_OUTPUT_CONTRACT } from "../prompts/l1-extraction.js";
+import type { ConversationMessage } from "../conversation/l0-recorder.js";
+import type { LLMRunner, LLMRunParams } from "../types.js";
+
+/**
+ * End-to-end regression for the gateway reply shapes observed on 2026-10-11
+ * (real upstream, `deepseek-v4.1-flash` behind an agentic chat gateway):
+ *
+ *   no contract  → fenced ```json single OBJECT `{scene_name, memories:[…]}`
+ *                  (the greedy /\[[\s\S]*\]/ then parsed the inner `memories`
+ *                   array as if it were the scene list → 3 empty scenes →
+ *                   every memory silently dropped) or fenced YAML prose
+ *   contract     → bare array `[{scene_name, message_ids, memories:[…]}]`
+ *
+ * The runner stub replays those exact strings, so these tests pin the whole
+ * path: contract injection, outermost-JSON extraction, object→array wrap, and
+ * the L1EmptyReason diagnostics.
+ */
+
+const MESSAGES: ConversationMessage[] = [
+  {
+    id: "m1",
+    role: "user",
+    content:
+      "我的个人偏好清单：1) 部署脚本必须先做健康检查再启动；2) 所有交付产物放 shared 目录不放 workspace；3) 远程服务器是 119.13.109.93，别名 vps，已配好密钥登录。",
+    timestamp: 1_791_588_843_272,
+  },
+  { id: "m2", role: "assistant", content: "收到，我把三条都记进长期记忆。", timestamp: 1_791_588_844_272 },
+];
+
+/** Reply captured verbatim from the gateway without any user-turn contract. */
+const GATEWAY_OBJECT_REPLY = [
+  "```json",
+  "{",
+  '  "scene_name": "用户个人偏好清单与远程服务器配置",',
+  '  "memories": [',
+  "    {",
+  '      "content": "用户的部署脚本要求：必须先做健康检查再启动。",',
+  '      "timestamp": "2026-10-11T15:08:22.803Z"',
+  "    },",
+  "    {",
+  '      "content": "用户的交付产物存放约定：所有交付产物放在 shared 目录，不放 workspace。",',
+  '      "timestamp": "2026-10-11T15:08:22.803Z"',
+  "    },",
+  "    {",
+  '      "content": "用户的远程服务器信息：IP 为 119.13.109.93，别名 vps，已配置好密钥登录。",',
+  '      "timestamp": "2026-10-11T15:08:22.803Z"',
+  "    }",
+  "  ]",
+  "}",
+  "```",
+].join("\n");
+
+/** YAML prose — the gateway's other, unrecoverable drift. */
+const GATEWAY_YAML_REPLY = [
+  "```yaml",
+  "scene_name: 用户个人偏好清单",
+  "memory_content: |",
+  "  用户的个人偏好（2026-10-11 提出）：",
+  "  1) 部署脚本必须先做健康检查再启动；",
+  "```",
+].join("\n");
+
+/** Reply captured with the contract appended to the user turn. */
+const CONTRACTED_ARRAY_REPLY = JSON.stringify([
+  {
+    scene_name: "个人偏好与服务器信息记录",
+    message_ids: ["m1"],
+    memories: [
+      { content: "部署脚本必须先做健康检查再启动。", type: "instruction", priority: 90, source_message_ids: ["m1"], metadata: {} },
+      { content: "所有交付产物放 shared 目录，不放 workspace。", type: "instruction", priority: 90, source_message_ids: ["m1"], metadata: {} },
+      { content: "远程服务器 IP 为 119.13.109.93，别名 vps，已配置密钥登录。", type: "persona", priority: 85, source_message_ids: ["m1"], metadata: {} },
+    ],
+  },
+]);
+
+interface StubCapture {
+  prompts: string[];
+  outputContracts: Array<string | undefined>;
+}
+
+function makeStubRunner(scripted: string[]): { runner: LLMRunner; capture: StubCapture } {
+  const capture: StubCapture = { prompts: [], outputContracts: [] };
+  let i = 0;
+  const runner: LLMRunner = {
+    async run(params: LLMRunParams) {
+      capture.prompts.push(params.prompt);
+      capture.outputContracts.push(params.outputContract);
+      const reply = scripted[Math.min(i, scripted.length - 1)];
+      i += 1;
+      return reply ?? "";
+    },
+  };
+  return { runner, capture };
+}
+
+function makeLogger(capture: string[]) {
+  return {
+    debug: (m: string) => { capture.push(m); },
+    info: (m: string) => { capture.push(m); },
+    warn: (m: string) => { capture.push(m); },
+    error: (m: string) => { capture.push(m); },
+  };
+}
+
+describe("L1 extraction against observed gateway reply shapes", () => {
+  let baseDir: string;
+  beforeEach(() => { baseDir = fs.mkdtempSync(path.join(os.tmpdir(), "l1-shape-")); });
+  afterEach(() => { fs.rmSync(baseDir, { recursive: true, force: true }); });
+
+  it("recovers every memory from a single-scene OBJECT reply (greedy-array regression)", async () => {
+    const logs: string[] = [];
+    const { runner } = makeStubRunner([GATEWAY_OBJECT_REPLY]);
+
+    const result = await extractL1Memories({
+      messages: MESSAGES,
+      sessionKey: "s-gateway-object",
+      baseDir,
+      config: {},
+      options: { enableDedup: false, llmRunner: runner },
+      logger: makeLogger(logs),
+    });
+
+    expect(result.extractedCount).toBe(3);
+    expect(result.storedCount).toBe(3);
+    // The wrap is observable via the shape-repair diagnostic…
+    expect(logs.some((l) => l.includes("SHAPE_REPAIR object→array"))).toBe(true);
+    // …and the memories actually reached the JSONL shard.
+    const shard = fs.readdirSync(path.join(baseDir, "records"))[0]!;
+    const lines = fs.readFileSync(path.join(baseDir, "records", shard), "utf-8").trim().split("\n");
+    expect(lines).toHaveLength(3);
+    expect(lines.filter((l) => l.includes("部署脚本"))).toHaveLength(1);
+  });
+
+  it("still reports no_json when the gateway answers with YAML prose", async () => {
+    const logs: string[] = [];
+    const { runner } = makeStubRunner([GATEWAY_YAML_REPLY]);
+
+    const result = await extractL1Memories({
+      messages: MESSAGES,
+      sessionKey: "s-gateway-yaml",
+      baseDir,
+      config: {},
+      options: { enableDedup: false, llmRunner: runner },
+      logger: makeLogger(logs),
+    });
+
+    expect(result.extractedCount).toBe(0);
+    expect(logs.some((l) => l.includes("l1-empty reason=no_json"))).toBe(true);
+  });
+
+  it("passes the L1 contract to the runner so the gateway reply stays parseable", async () => {
+    const { runner, capture } = makeStubRunner([CONTRACTED_ARRAY_REPLY]);
+
+    const result = await extractL1Memories({
+      messages: MESSAGES,
+      sessionKey: "s-contract",
+      baseDir,
+      config: {},
+      options: { enableDedup: false, llmRunner: runner },
+    });
+
+    expect(result.extractedCount).toBe(3);
+    expect(capture.outputContracts[0]).toBe(L1_JSON_OUTPUT_CONTRACT);
+    // The runner (not the caller) is responsible for appending it last, so the
+    // caller's prompt must stay untouched and still end with the message block.
+    expect(capture.prompts[0]).toContain("务必结合 timestamp 推算时间，只从这里提取记忆");
+    expect(capture.prompts[0]).not.toContain("输出要求（必须严格遵守");
+  });
+
+  it("keeps the {scenes:[…]} wrapper tolerance", async () => {
+    const reply = JSON.stringify({
+      scenes: [
+        { scene_name: "包装形状", message_ids: ["m1"], memories: [{ content: "包装里的记忆。", type: "episodic", priority: 60, source_message_ids: ["m1"], metadata: {} }] },
+      ],
+    });
+    const { runner } = makeStubRunner([reply]);
+
+    const result = await extractL1Memories({
+      messages: MESSAGES,
+      sessionKey: "s-wrapper",
+      baseDir,
+      config: {},
+      options: { enableDedup: false, llmRunner: runner },
+    });
+
+    expect(result.extractedCount).toBe(1);
+    expect(result.sceneNames).toEqual(["包装形状"]);
+  });
+
+  it("keeps the singular `memory` / bare-string tolerances", async () => {
+    const reply = JSON.stringify([
+      { scene_name: "单数对象", message_ids: ["m1"], memory: { content: "单数形式的记忆。", type: "episodic" } },
+      { scene_name: "裸字符串", message_ids: ["m1"], memory: "裸字符串记忆。" },
+    ]);
+    const { runner } = makeStubRunner([reply]);
+
+    const result = await extractL1Memories({
+      messages: MESSAGES,
+      sessionKey: "s-singular",
+      baseDir,
+      config: {},
+      options: { enableDedup: false, llmRunner: runner },
+    });
+
+    expect(result.extractedCount).toBe(2);
+  });
+});
